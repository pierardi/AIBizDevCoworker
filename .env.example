# Amplify Hosting and local API read these names (plus the PG* / DATABASE_URL aliases).
openai_api_key=sk-your-openai-key

# Database — used by the API only, not the browser bundle.
# Amplify console: openai_api_key plus any of these database names.
PGHOST=your-rds-hostname.rds.amazonaws.com
PGPORT=5432
PGDATABASE=bizdev
PGUSER=postgres
PGPASSWORD=change-me
PGSSLMODE=require

# Optional aliases also accepted:
# DATABASE_URL=postgresql://user:pass@host:5432/bizdev
# database_host=
# database_port=5432
# database_name=bizdev
# database_user=postgres
# database_password=

PORT=8787
# API_URL=https://your-api.example.com
